[Unit]
Description=borgmatic backup
Wants=network-online.target
After=network-online.target
ConditionACPower=true

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
# Skip on metered connections (NM Metered: 1 = yes, 3 = guessed yes).
ExecCondition=/bin/sh -c '! busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered | grep -qE " (1|3)$"'
ExecStart=/usr/bin/borgmatic --verbosity -1 --syslog-verbosity 1
