# put this in ~/gitconfig.d/identity
# [user]
#   name = Moritz Bracht
#   email = moritz.bracht@example.org
#   signingkey = AB123456
[include]
	path = ~/.gitconfig.d/identity
	path = ~/.gitconfig.d/local
[commit]
	gpgSign = true
[push]
	default = current
	followTags = true
[alias]
	co = checkout
	ci = commit -S -v
	undo = reset --soft 'HEAD~'
	m = merge -S
	fixup = "!f(){ git reset --soft HEAD~${1} && git commit --amend -C HEAD; };f"
[merge]
	ff = false
	tool = vimdiff
[pull]
	rebase = true
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
    ; features = side-by-side line-numbers decorations
    features = side-by-side line-numbers decorations
    ; syntax-theme = Dracula
    plus-style = syntax bold "#002200"
    minus-style = syntax bold "#440000"
[delta "decorations"]
    commit-decoration-style = bold grey box ul
    file-style = bold grey ul
    file-decoration-style = none
    hunk-header-decoration-style = grey box ul
[delta "line-numbers"]
    line-numbers-left-style = grey
    line-numbers-right-style = grey
    line-numbers-minus-style = 124
    line-numbers-plus-style = 28
[gpg]
	program = gpg2
[init]
	defaultBranch = main
[mergetool "vimdiff"]
	path = nvim
